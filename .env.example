# FRED API Key (Required for most indicators)
# Get your free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional API Keys (only needed if using these services)
# Alpha Vantage API Key
# Get at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Polygon.io API Key
# Get at: https://polygon.io/
POLYGON_API_KEY=your_polygon_key_here

# BLS (Bureau of Labor Statistics) API Key
# Get at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=your_bls_key_here
